{
  "name": "suministros-backend",
  "version": "1.0.0",
  "description": "Backend de Suministros Institucionales (clientes, chatbot, reportes) para VS Code / Node.js",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:assistant && npm run test:legacy",
    "test:assistant": "jest --runInBand",
    "test:legacy": "node --test test/*.test.js",
    "test:integration": "jest --runInBand --testMatch \"**/test/integration/*.int.spec.js\"",
    "claves:generar": "node scripts/generar-claves.js --escribir",
    "padron:importar": "node scripts/importar-padron.js",
    "medir": "node scripts/medir-rendimiento.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.17.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testMatch": [
      "**/test/assistant.spec.js",
      "**/test/account-registration-phase0.spec.js",
      "**/test/mi-cuenta.spec.js",
      "**/test/db-account-migration.spec.js"
    ]
  }
}

PORT=8081

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_secret
DB_NAME=your_database_name
DB_CONNECTION_LIMIT=3
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8765,http://127.0.0.1:8765,http://localhost:8081,http://127.0.0.1:8081
TRUST_PROXY_HOPS=1

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DIAS=7
CRYPTO_KEY=replace_with_exactly_32_characters
ADMIN_EMAIL=admin@example.com
# Mínimo 12 caracteres; sin ella no se crea el administrador inicial.
ADMIN_PASSWORD=replace_before_first_start

# Use a different random secret per service.
MFA_TOKEN_PEPPER=replace_with_a_different_32_character_random_secret
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret
RECEIPT_LINK_SECRET=replace_with_another_long_random_secret
ADMIN_NOTIFICATION_EMAIL=
RECEIPT_LINK_BASE_URL=http://localhost:8081

# n8n: ya no recibe correos ni códigos (se envían por SMTP directo). Las variables MFA/RECEIPT quedan sin uso.
N8N_CHAT_WEBHOOK_URL=
N8N_API_TOKEN=
N8N_MFA_WEBHOOK_URL=
N8N_MFA_WEBHOOK_SECRET=
N8N_RECEIPT_WEBHOOK_URL=
N8N_RECEIPT_WEBHOOK_SECRET=

# Distinct secrets/tokens per workflow. Webhook URLs must use HTTPS outside localhost.
N8N_W1_PAYMENT_WEBHOOK_URL=
N8N_W1_SECRET=
N8N_W2_DAILY_SUMMARY_TOKEN=
N8N_W3_STOCK_WEBHOOK_URL=
N8N_W3_SECRET=
N8N_W4_EXPIRY_TOKEN=
N8N_W6_ASSISTANT_ESCALATION_WEBHOOK_URL=
N8N_W6_ASSISTANT_ESCALATION_SECRET=
N8N_W8_ACCOUNT_WEBHOOK_URL=
N8N_W8_ACCOUNT_SECRET=
ASSISTANT_WEEKLY_SUMMARY_TOKEN=
ASSISTANT_MODE=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
AUTOMATION_STOCK_LOW_THRESHOLD=5

# --- Verificación institucional (migración 001) ---
# Carpeta PRIVADA para documentos cifrados de acreditación (no la sirvas como estática).
DOCUMENTOS_DIR=
# Registros permitidos por IP y por hora.
REGISTRO_LIMITE_POR_HORA=10

# --- Verificación en la compra (migración 002) ---
# Anillo de claves AES-256-GCM: id:base64 de 32 bytes aleatorios, separadas por coma.
# Generar: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Para rotar: agregar k2, ponerla activa y conservar k1 mientras haya datos cifrados con ella.
CRYPTO_KEYS=
CRYPTO_KEY_ACTIVA=
# Clave HMAC (base64, 32 bytes o más) DISTINTA de las de cifrado: índice de documentos de identidad.
IDENT_HMAC_KEY=
# Días de vigencia de una verificación aprobada (máx. 730).
VERIFICACION_VIGENCIA_DIAS=365
# n8n W11: eventos firmados hacia n8n, respuestas firmadas de n8n (secreto distinto) y mantenimiento.
N8N_W11_VERIFICATION_WEBHOOK_URL=
N8N_W11_SECRET=
N8N_W11_CALLBACK_SECRET=
N8N_W11_MAINTENANCE_TOKEN=
# Superadministrador: solo para scripts/crear-superadmin.js (mínimo 16 caracteres). Bórrala después de usarla.
SUPERADMIN_PASSWORD=

# --- Pruebas de integración (solo MySQL local cuyo nombre contenga "test") ---
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_USER=test
TEST_DB_PASSWORD=
TEST_DB_NAME=suministros_test

# --- Registro verificado (migración 003) ---
# Generar: node scripts/generar-claves.js --escribir   (solo agrega las que falten)
# ENC_KEY y HMAC_KEY: 32 bytes en hex (64 caracteres), DISTINTAS. Sin ellas el servidor no arranca.
# Si se pierde ENC_KEY, el padrón y las solicitudes cifradas no se recuperan: guárdala fuera del equipo.
ENC_KEY=
ENC_KEY_VERSION=1
# Rotación: nueva ENC_KEY con ENC_KEY_VERSION=2 y la anterior en ENC_KEY_V1 mientras haya datos cifrados con ella.
# ENC_KEY_V1=
HMAC_KEY=
# Costo de bcrypt (10 en laboratorio ≈ 40 ms; 12 recomendado en producción).
BCRYPT_COST=10

# Fuente del padrón (en el laboratorio, la base que simula la del Estado; solo lectura).
# Se copia cifrada a padron_institucional al arrancar y cada PADRON_SYNC_MINUTOS.
# Si no se define, se usa MYSQL_ADDON_URI.
PADRON_DB_URI=
PADRON_SYNC_MINUTOS=10

# Correo (nodemailer). Laboratorio gratuito: Mailpit en Docker (SMTP 1025, buzón http://localhost:8025).
# Sin SMTP (o con el SMTP de laboratorio apagado) el mensaje se imprime en la consola.
# En producción sin SMTP_HOST el servidor no arranca.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Suministros Institucionales <no-reply@localhost>

# n8n W12: avisos {evento, solicitud_id, resultado} firmados con HMAC (X-Timestamp, X-Signature).
# Opcional: sin URL no se envía nada. El mismo secreto va en n8n/.env.
N8N_REGISTRO_WEBHOOK_URL=http://localhost:5678/webhook/registro-avisos
N8N_REGISTRO_SECRET=
